{
  "name": "Shopify Order to Email",
  "nodes": [
    { "name": "Shopify Order Trigger", "type": "n8n-nodes-base.shopifytrigger" },
    {
      "name": "Send Order Email",
      "type": "n8n-nodes-base.emailsend",
      "parameters": {
        "to": "orders@example.com",
        "subject": "New Shopify Order",
        "text": "A new order has been placed in your Shopify store."
      }
    }
  ],
  "connections": {
    "Shopify Order Trigger": { "main": [[{ "node": "Send Order Email" }]] }
  }
}
